{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.speediance-pipeline/schema/status.schema.json",
  "title": "Connector status",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "timezone", "generated_at", "sources"],
  "properties": {
    "schema_version": {"const": "1.3.0"},
    "timezone": {"const": "America/Los_Angeles"},
    "generated_at": {"type": "string", "format": "date-time"},
    "sources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["speediance"],
      "properties": {
        "speediance": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "last_successful_sync", "last_attempt", "error"],
          "properties": {
            "status": {"enum": ["ok", "stale"]},
            "last_successful_sync": {"type": ["string", "null"], "format": "date-time"},
            "last_attempt": {"type": "string", "format": "date-time"},
            "error": {"type": ["string", "null"]}
          }
        }
      }
    }
  }
}
