{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.speediance-pipeline/schema/latest.schema.json",
  "title": "Newest Speediance training day pointer",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "source", "date", "file", "generated_at"],
  "properties": {
    "schema_version": {"const": "1.3.0"},
    "source": {"const": "speediance"},
    "date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "file": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}\\.json$"},
    "generated_at": {"type": "string", "format": "date-time"}
  }
}
