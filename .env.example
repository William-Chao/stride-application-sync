# Copy to .env (or run scripts/login.py, which writes it). Never commit .env.
# Nothing here is a real secret.

# App user id (appUserId from login, or the App_user_id header).
SPEEDIANCE_USER_ID=

# Token (from login, or the Token request header). Host-bound to the region.
SPEEDIANCE_TOKEN=

# Global (USA/Asia, api2.speediance.com) or EU (euapi.speediance.com).
SPEEDIANCE_REGION=Global

# Account weight unit fallback. 0 = kilograms, 1 = pounds.
SPEEDIANCE_UNIT=0

# Raw, normalized, and status files. Default: ~/fitness-data
SPEEDIANCE_OUTPUT_DIR=~/fitness-data

# One JSON file per training day. Default: ~/fitness-data/daily
SPEEDIANCE_DAILY_DIR=~/fitness-data/daily

# Optional inclusive start date (YYYY-MM-DD). Unset: first sync = 12 months back,
# later syncs resume one month before the last success.
# SPEEDIANCE_START_DATE=

# Minimum seconds between API calls. Default 1.5.
# SPEEDIANCE_REQUEST_DELAY_S=1.5

# Set to 1 to replay the test fixtures instead of the network.
# SPEEDIANCE_FAKE=1
